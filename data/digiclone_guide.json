  "stat_descriptions": {
    "AT": {
      "name": "Attack (พลังโจมตี)",
      "priority": "อันดับ 1 (สำคัญที่สุด)",
      "badge_color": "#ef4444",
      "desc": "เพิ่มค่าพลังโจมตีพื้นฐานโดยตรง ทำให้ทั้งการโจมตีปกติและสกิลทุกท่า F1 - F4 รุนแรงขึ้นมหาศาล โคลนเต็ม 15/15 จะได้โบนัส +144% AT ต้องทำเต็มเป็นอย่างแรกเสมอ!"
    },
    "CT": {
      "name": "Critical (อัตราคริติคอล)",
      "priority": "อันดับ 2 (จำเป็นในเอนด์เกม)",
      "badge_color": "#f59e0b",
      "desc": "เพิ่มโอกาสติดคริติคอล โคลนเต็ม 15/15 จะได้โบนัส +720% CT ช่วยเจาะเกราะต้านคริติคอลของเรดบอสเอนด์เกมเซิร์ฟไทย (บอส Lv. 140 - 160) ให้ติดคริติคอล 100% ทุกฮิต"
    },
    "BL": {
      "name": "Block (อัตราการบล็อก)",
      "priority": "อันดับ 3 (สายแทงค์/ลงดัน)",
      "badge_color": "#3b82f6",
      "desc": "เป็นสเตตัสเดียวที่คิดแบบ Flat % บวกตรงๆ ทันที! โคลนเต็ม 15/15 จะได้รับ Block +87% เมื่อรวมกับสเตตัสพื้นฐานจะเกิน 100% ทำให้ลดแดเมจกายภาพจากบอสลง 50% ตลอดเวลา"
    },
    "EV": {
      "name": "Evasion (การหลบหลีก)",
      "priority": "อันดับ 4 (สายทั่วไป)",
      "badge_color": "#10b981",
      "desc": "เพิ่มอัตราการหลบหลีกการโจมตีกายภาพ โคลนเต็ม 15/15 จะได้โบนัส +576% EV เหมาะสำหรับเก็บเลเวลหรือรับมือมอนสเตอร์ทั่วไปในแผนที่"
    },
    "HP": {
      "name": "Health (พลังชีวิตสูงสุด)",
      "priority": "อันดับ 4 (สายเอนด์เกม)",
      "badge_color": "#06b6d4",
      "desc": "โคลนเต็ม 15/15 จะได้รับโบนัส Max HP +54% มีประโยชน์มหาศาลในการลงดันเจี้ยนเอนด์เกมรุ่นใหม่ เพื่อดันเลือดให้แตะเกณฑ์ 80k - 120k+ ป้องกันการตายหมู่จากสกิล AoE"
    }
  },
