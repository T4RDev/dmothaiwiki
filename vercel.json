{
  "version": 2,
  "framework": null,
  "outputDirectory": "web/static",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://dmothaiwiki.onrender.com/api/$1"
    },
    {
      "source": "/images/patch/(.*)",
      "destination": "https://dmothaiwiki.onrender.com/images/patch/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "https://pub-f7d271edf6e24f25b6b06f2767a3dfe3.r2.dev/images/$1"
    },
    {
      "source": "/models/(.*)",
      "destination": "https://pub-f7d271edf6e24f25b6b06f2767a3dfe3.r2.dev/models/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
