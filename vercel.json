{
  "version": 2,
  "framework": null,
  "outputDirectory": "web/static",
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/images/patch/promo-dmo_(.*)",
      "destination": "https://37bt4.upcloudobjects.com/promo-dmo/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "https://pub-f7d271edf6e24f25b6b06f2767a3dfe3.r2.dev/images/$1"
    },
    {
      "source": "/models/(.*)",
      "destination": "https://pub-f7d271edf6e24f25b6b06f2767a3dfe3.r2.dev/models/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
