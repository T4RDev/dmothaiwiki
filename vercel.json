{
  "version": 2,
  "framework": null,
  "outputDirectory": "web/static",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/api/:path*",
      "destination": "https://dmothaiwiki.onrender.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://dmothaiwiki.onrender.com/images/:path*"
    },
    {
      "source": "/models/:path*",
      "destination": "https://dmothaiwiki.onrender.com/models/:path*"
    },
    {
      "source": "/((?!api|images|models|static|favicon).*)$",
      "destination": "/index.html"
    }
  ]
}
