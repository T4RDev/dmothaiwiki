{
  "version": 2,
  "framework": null,
  "outputDirectory": "web/static",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dmothaiwiki.onrender.com/api/:path*"
    },
    {
      "source": "/images/patch/:path*",
      "destination": "https://dmothaiwiki.onrender.com/images/patch/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://pub-f7d271edf6e24f25b6b06f2767a3dfe3.r2.dev/images/:path*"
    },
    {
      "source": "/models/:path*",
      "destination": "https://pub-f7d271edf6e24f25b6b06f2767a3dfe3.r2.dev/models/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
